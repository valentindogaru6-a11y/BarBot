BOT_TOKEN=replace_with_your_telegram_bot_token
CATALOG_PATH=data/catalog.json
DATABASE_PATH=data/barbot.db
SUPER_ADMIN_IDS=[123456789]
# Deprecated bootstrap fallback when SUPER_ADMIN_IDS is not set:
ADMIN_IDS=123456789

# Local offline voice search
VOICE_SEARCH_ENABLED=true
VOSK_MODEL_PATH=models/vosk-model-small-ru-0.22
VOSK_LANGUAGE=ru
VOICE_MAX_DURATION_SECONDS=30
VOICE_MAX_FILE_SIZE_MB=10
VOICE_MAX_CONCURRENT=1
VOICE_DEBUG_TRANSCRIPTS=false

# Warehouse Telegram UX (requires schema migration and explicit seed import)
WAREHOUSE_ENABLED=false
WAREHOUSE_REPORTS_PATH=reports/warehouse

# AI assistant pilot (private chat, super_admin only; disabled by default)
# Text requires Gemini; voice requires both Gemini and Groq.
AI_ASSISTANT_ENABLED=false
AI_TEXT_ENABLED=false
AI_VOICE_ENABLED=false
AI_GENERAL_CHAT_ENABLED=false
AI_WEB_SEARCH_ENABLED=false
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_STRONG_MODEL=gemini-3.8-flash
AI_VOICE_MAX_DURATION_SECONDS=180
AI_VOICE_MAX_FILE_BYTES=20971520
AI_REQUEST_TIMEOUT_SECONDS=30
AI_CONVERSATION_TTL_SECONDS=86400
AI_CONVERSATION_MAX_TURNS=12
AI_CONVERSATION_MAX_CHARS=12000
AI_WEB_SEARCH_MAX_PROVIDER_CALLS_PER_UPDATE=1
