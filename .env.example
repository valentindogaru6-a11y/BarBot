BOT_TOKEN=replace_with_your_telegram_bot_token
CATALOG_PATH=data/catalog.json
DATABASE_PATH=data/barbot.db
SUPER_ADMIN_IDS=[123456789]
# Deprecated bootstrap fallback when SUPER_ADMIN_IDS is not set:
ADMIN_IDS=123456789

# Local offline voice search
VOICE_SEARCH_ENABLED=true
VOSK_MODEL_PATH=models/vosk-model-small-ru-0.22
VOSK_LANGUAGE=ru
VOICE_MAX_DURATION_SECONDS=30
VOICE_MAX_FILE_SIZE_MB=10
VOICE_MAX_CONCURRENT=1
VOICE_DEBUG_TRANSCRIPTS=false

# Warehouse Telegram UX (requires schema migration and explicit seed import)
WAREHOUSE_ENABLED=false
WAREHOUSE_REPORTS_PATH=reports/warehouse

# AI assistant pilot (private chat, super_admin only; disabled by default)
# Text requires Gemini; voice requires both Gemini and Groq.
AI_ASSISTANT_ENABLED=false
# Safe default: only active super_admin users explicitly listed below may enter AI.
# Use comma-separated positive Telegram IDs or a JSON array; never commit real IDs.
AI_ACCESS_MODE=pilot_allowlist
AI_PILOT_USER_IDS=
AI_TEXT_ENABLED=false
AI_VOICE_ENABLED=false
AI_GENERAL_CHAT_ENABLED=false
AI_WEB_SEARCH_ENABLED=false
AI_PLANNER_MODE=local_first
AI_PLANNER_PRIMARY_PROVIDER=gemini
AI_PLANNER_FALLBACK_PROVIDER=groq
# Ignored entirely while disabled; identical primary/fallback rejected only on enable.
AI_PLANNER_FALLBACK_ENABLED=false
AI_PLANNER_TOTAL_DEADLINE_SECONDS=12
GEMINI_PLANNER_MODEL=gemini-3.5-flash-lite
GROQ_PLANNER_FALLBACK_MODEL=openai/gpt-oss-120b
GEMINI_PLANNER_CONNECT_SECONDS=3
GEMINI_PLANNER_READ_SECONDS=4
GEMINI_PLANNER_TOTAL_SECONDS=5
GROQ_PLANNER_CONNECT_SECONDS=3
GROQ_PLANNER_READ_SECONDS=5
GROQ_PLANNER_TOTAL_SECONDS=8
GEMINI_PLANNER_MIN_INTERVAL_SECONDS=10
GROQ_PLANNER_MIN_INTERVAL_SECONDS=15
GEMINI_PLANNER_COOLDOWN_SECONDS=90
GROQ_PLANNER_COOLDOWN_SECONDS=90
AI_PLANNER_PHYSICAL_CONCURRENCY=1
AI_REQUEST_GLOBAL_CONCURRENCY=2
AI_REQUEST_USER_COOLDOWN_SECONDS=2
AI_REQUEST_QUEUE_POLICY=immediate_busy
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_PLANNER_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_STRONG_MODEL=gemini-3.8-flash
AI_VOICE_MAX_DURATION_SECONDS=180
AI_VOICE_MAX_FILE_BYTES=20971520
AI_REQUEST_TIMEOUT_SECONDS=30
AI_CONVERSATION_TTL_SECONDS=86400
AI_CONVERSATION_MAX_TURNS=12
AI_CONVERSATION_MAX_CHARS=12000
AI_WEB_SEARCH_MAX_PROVIDER_CALLS_PER_UPDATE=1
